{# {% from 'src/templates/partials/ui/icon.twig' import icon %} #}
<section class="banner">
	<div class="banner__content">
		<h1 class="banner__title">{{ banner.title }}</h1>
		<p class="banner__subtitle">{{ banner.subtitle }}</p>
		<dl class="banner__list">
			{% for item in banner.list %}
				<dt class="banner__number">{{ item.number }}</dt>
				<dd class="banner__label">{{ item.label }}</dd>
			{% endfor %}
		</dl>
		<div class="banner__action">
			{% for button in banner.buttons %}
				{% if button.type == "link" %}
					<button class="button button--large button--primary">{{ button.label }}</button>
					<a href="{{ button.url }}" class="button button--large button--secondary">{{ button.label }}</a>
				{% endif %}
			{% endfor %}
		</div>
	</div>
	<div class="banner__image">
    	<img width="534" height="642" src="/src/assets/images/banner/banner-cube.png" alt="Banner">
	</div>
</section>
