<section class="faq">
  <h2 class="faq__title">{{ faq.title }}</h2>
  <ul class="faq__list">
    {% for item in faq.items %}
      <li class="faq__item">
	  	<div class="faq__item-header">
        	<h3 class="faq__question">{{ item.question }}</h3>
			<div class="faq__item-icon"></div>
		</div>
		<div class="faq__item-content">
        	<p class="faq__answer">{{ item.answer }}</p>
		</div>
      </li>
    {% endfor %}
  </ul>
</section>
